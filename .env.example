# Copy this file to .env.local and fill in real values. Never commit .env/.env.local —
# both are gitignored. Vite only exposes vars prefixed VITE_ to client-side code; anything
# without that prefix stays server-only (safe for secret keys used in Vercel serverless
# functions / API routes, once those exist).
#
# Nothing below is wired up yet — this is a placeholder for when each integration lands.

# Supabase (client-safe: URL + anon key are meant to be public, RLS enforces access control)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Stripe (publishable key is client-safe; the secret key must NOT use the VITE_ prefix —
# it should only ever be read server-side, e.g. in a Vercel API route)
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Resend (server-only — do not prefix with VITE_, never expose to the client bundle)
# RESEND_API_KEY=
